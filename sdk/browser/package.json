{
  "name": "@1kbirds/chidori-browser",
  "version": "0.1.0",
  "description": "Client-side chidori agents in the browser: the wasm engine + durable replay runtime, with host effects (LLM, fetch, input, tools) served by the page.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ThousandBirdsInc/chidori",
    "directory": "sdk/browser"
  },
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "react.js",
    "react.d.ts",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=16.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "sideEffects": false
}
